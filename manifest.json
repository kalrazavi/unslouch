{
  "manifest_version": 3,
  "name": "Unslouch",
  "version": "1.0.1",
  "description": "Posture and movement breaks through your shift. Do the move, check it off, grow the plant.",
  "permissions": ["alarms", "notifications", "storage"],
  "background": { "service_worker": "background.js", "type": "module" },
  "action": { "default_popup": "popup.html", "default_title": "Unslouch" },
  "icons": { "16": "icon16.png", "48": "icon48.png", "128": "icon128.png" }
}
